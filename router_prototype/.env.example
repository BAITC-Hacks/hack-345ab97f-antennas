# Скопируй этот файл в .env и заполни. Файл .env НИКОГДА не коммитим в git.

# Ключ провайдера LLM
LLM_API_KEY=

# Название модели — смотри актуальный список у провайдера.
# Для роутера бери быструю модель без "reasoning" (класс mini / flash / haiku и т.п.)
LLM_MODEL=

# Адрес API. Пусто = OpenAI. Другие OpenAI-совместимые провайдеры (проверь в их документации):
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1   (один ключ — много моделей, удобно для bake-off)
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=

# json_schema (строгий формат) или json_object (если модель не умеет json_schema)
LLM_RESPONSE_FORMAT=json_schema
