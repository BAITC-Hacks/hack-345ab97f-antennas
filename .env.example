# Never commit the real .env file.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_STRUCTURED_OUTPUT=true
# Confidence from token logprobs; set false for providers without logprobs support
LLM_LOGPROBS=true
ROUTER_ROUTE_THRESHOLD=0.75
ROUTER_MARGIN_THRESHOLD=0.20
ROUTER_HANDOFF_THRESHOLD=0.45
ROUTER_CATALOG_PATH=data/scenarios.json
