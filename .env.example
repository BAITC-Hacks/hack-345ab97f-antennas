# Never commit the real .env file.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_STRUCTURED_OUTPUT=true
# Confidence from token logprobs; set false for providers without logprobs support
LLM_LOGPROBS=true
ROUTER_ROUTE_THRESHOLD=0.75
ROUTER_MARGIN_THRESHOLD=0.20
ROUTER_HANDOFF_THRESHOLD=0.45
ROUTER_CATALOG_PATH=data/scenarios.json
STT_PROVIDER=none
TTS_PROVIDER=none
SPEECH_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
DIALOG_DB_PATH=backend/dialogs.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
