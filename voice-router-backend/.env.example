# Never paste real credentials into source code or chat.
PORT=8000
ROUTER_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
STT_MODEL=gpt-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
# Speech calls are opt-in and require ROUTER_MODE=openai.
VOICE_ENABLED=false
OPENAI_TIMEOUT_MS=30000
# For the existing standalone frontend:
FRONTEND_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
